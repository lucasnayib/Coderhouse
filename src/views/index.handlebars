<section class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Productos</h1>
    <p class="text-muted mb-0">Filtra por categoría o disponibilidad y navega con paginación.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/products">Limpiar filtros</a>
</section>

<form class="row gy-2 gx-3 align-items-end mb-4" method="get">
  <div class="col-sm-3">
    <label for="query" class="form-label">Categoría o disponibilidad</label>
    <input
      type="text"
      class="form-control"
      id="query"
      name="query"
      value="{{query}}"
      placeholder="ej: available, electronics"
    />
  </div>
  <div class="col-sm-2">
    <label for="sort" class="form-label">Orden por precio</label>
    <select id="sort" name="sort" class="form-select">
      <option value="" {{#unless sort}}selected{{/unless}}>Sin orden</option>
      <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Ascendente</option>
      <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Descendente</option>
    </select>
  </div>
  <div class="col-sm-2">
    <label for="limit" class="form-label">Límite</label>
    <input type="number" min="1" class="form-control" id="limit" name="limit" value="{{limit}}" />
  </div>
  <div class="col-sm-3">
    <label for="cid" class="form-label">Carrito destino (opcional)</label>
    <input type="text" class="form-control" id="cid" name="cid" value="{{cartId}}" />
    <div class="form-text">Usa un ID de carrito válido para activar "Agregar".</div>
  </div>
  <div class="col-sm-2">
    <button type="submit" class="btn btn-primary w-100">Buscar</button>
  </div>
</form>

{{#if products.length}}
  <div class="row g-3">
    {{#each products}}
      <div class="col-md-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body d-flex flex-column">
            <h2 class="h5 card-title">{{this.title}}</h2>
            <p class="text-muted mb-1">Categoría: {{this.category}}</p>
            <p class="mb-2">{{this.description}}</p>
            <p class="fw-bold mb-2">$ {{this.price}}</p>
            <p class="mb-3">Disponibilidad: {{#if this.status}}Disponible{{else}}Agotado{{/if}}</p>
            <div class="mt-auto d-flex gap-2">
              <a class="btn btn-outline-secondary" href="/products/{{this._id}}">Ver detalles</a>
              {{#if ../cartId}}
                <form action="/api/carts/{{../cartId}}/products/{{this._id}}" method="post">
                  <button type="submit" class="btn btn-primary">Agregar al carrito</button>
                </form>
              {{else}}
                <button class="btn btn-secondary" disabled>Agrega un cid para comprar</button>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="alert alert-info">No hay productos para mostrar.</div>
{{/if}}

<nav aria-label="Paginación" class="mt-4">
  <ul class="pagination justify-content-center">
    <li class="page-item {{#unless pagination.hasPrevPage}}disabled{{/unless}}">
      {{#if pagination.prevLink}}
        <a class="page-link" href="{{pagination.prevLink}}">&laquo; Anterior</a>
      {{else}}
        <span class="page-link">&laquo; Anterior</span>
      {{/if}}
    </li>
    <li class="page-item active"><span class="page-link">Página {{pagination.page}}</span></li>
    <li class="page-item {{#unless pagination.hasNextPage}}disabled{{/unless}}">
      {{#if pagination.nextLink}}
        <a class="page-link" href="{{pagination.nextLink}}">Siguiente &raquo;</a>
      {{else}}
        <span class="page-link">Siguiente &raquo;</span>
      {{/if}}
    </li>
  </ul>
</nav>
